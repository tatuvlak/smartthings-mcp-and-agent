# SmartThings Configuration
SMARTTHINGS_PAT_TOKEN=your_personal_access_token_here
SMARTTHINGS_API_URL=https://api.smartthings.com
SMARTTHINGS_WEBHOOK_URL=https://your-domain.com/webhook

# LLM Configuration
# Supported: openai, anthropic, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama Configuration (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# MCP Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Agent Configuration
AGENT_CONFIRMATION_REQUIRED=true
AGENT_LOG_LEVEL=INFO

# Supported Providers (comma-separated)
ENABLED_PROVIDERS=smartthings

# Home Assistant (if using)
HOME_ASSISTANT_BASE_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_home_assistant_token_here

# Generic Matter/Thread Configuration (if using)
MATTER_CONTROLLER_URL=http://localhost:5580
MATTER_ADMIN_PIN=

# Alexa Configuration (if using)
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
ALEXA_REFRESH_TOKEN=
